#!/usr/bin/env python3
"""Every scheduled job on this machine, from one list: ~/.config/jobs.

  cron-jobs install [--quiet]  write the managed crontab block from the list
  cron-jobs run NAME           run one job: lock, timeout, log, record the result
  cron-jobs status             a table of every job; exit 1 if any needs a hand

A list line is `name timeout [host=a,b] m h dom mon dow command...`. The
command is a sh string; the crontab names the job only, so it never needs
cron quoting. State lives in ~/.local/state/jobs/.
"""
import datetime
import fcntl
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

BEGIN = "# BEGIN jobs (managed by ~/.local/bin/cron-jobs from ~/.config/jobs; edit that file)"
END = "# END jobs"
OLD_SYNC_MARK = "# dotfiles-sync"
LOG_CAP = 1_000_000
LOG_KEEP = 750_000
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
TIMEOUT_RE = re.compile(r"^(\d+)([smh])$")
FIELD_RE = re.compile(r"^[0-9A-Za-z*/,-]+$")
UNIT = {"s": 1, "m": 60, "h": 3600}


class ListError(Exception):
    pass


def home():
    return Path(os.environ["HOME"])


def list_path():
    return home() / ".config" / "jobs"


def state_dir():
    return home() / ".local" / "state" / "jobs"


def parse(text, where="~/.config/jobs", strict=True):
    """Return (jobs, problems). Strict raises on the first bad line; lenient
    skips it, so one bad line never stops the other jobs (the sync among them)."""
    jobs, problems, seen = [], [], set()
    for n, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        try:
            jobs.append(parse_line(line, raw, f"{where}:{n}", seen))
        except ListError as e:
            if strict:
                raise
            problems.append(str(e))
    return jobs, problems


def parse_line(line, raw, where, seen):
    head = line.split(None, 3)
    has_host = len(head) > 2 and head[2].startswith("host=")
    parts = line.split(None, 8 if has_host else 7)
    want = 9 if has_host else 8

    def bad(why):
        return ListError(f"{where}: {why}: {raw}")

    if len(parts) < want:
        raise bad("too few fields (name timeout [host=...] m h dom mon dow command)")
    name, timeout = parts[0], parts[1]
    hosts = []
    if has_host:
        hosts = [h.lower() for h in parts[2][5:].split(",") if h]
        if not hosts:
            raise bad("host= names no host")
    sched, command = parts[want - 6:want - 1], parts[want - 1]
    if not NAME_RE.match(name):
        raise bad(f"bad job name {name!r}")
    if name in seen:
        raise bad(f"job {name!r} listed twice")
    m = TIMEOUT_RE.match(timeout)
    if not m or int(m.group(1)) == 0:
        raise bad(f"bad timeout {timeout!r} (want e.g. 90s, 5m, 1h)")
    for f in sched:
        if not FIELD_RE.match(f):
            raise bad(f"bad schedule field {f!r}")
    seen.add(name)
    return {
        "name": name,
        "timeout": int(m.group(1)) * UNIT[m.group(2)],
        "hosts": hosts,
        "schedule": " ".join(sched),
        "command": command,
    }


def load(strict=True):
    p = list_path()
    try:
        text = p.read_text()
    except FileNotFoundError:
        raise ListError(f"{p}: no job list")
    return parse(text, strict=strict)


def short_hostname():
    try:
        out = subprocess.run(["hostname", "-s"], capture_output=True, text=True, check=True).stdout.strip()
        if out:
            return out.lower()
    except (OSError, subprocess.CalledProcessError):
        pass
    return socket.gethostname().split(".")[0].lower()


def runs_here(job, host):
    return not job["hosts"] or host in job["hosts"]


def block_for(jobs, host):
    lines = [BEGIN]
    for j in jobs:
        if runs_here(j, host):
            lines.append(f'{j["schedule"]} "$HOME/.local/bin/cron-jobs" run {j["name"]}')
    lines.append(END)
    return lines


def read_crontab():
    try:
        r = subprocess.run(["crontab", "-l"], capture_output=True, text=True)
    except FileNotFoundError:
        raise ListError("crontab: command not found")
    if r.returncode != 0:
        # "no crontab for <user>" is an empty crontab, not an error
        if "no crontab" in r.stderr.lower():
            return ""
        raise ListError(f"crontab -l failed: {r.stderr.strip()}")
    return r.stdout


def split_block(text):
    """Return (before, block or None, after) as lists of lines."""
    lines = text.splitlines()
    try:
        b = lines.index(BEGIN)
        e = lines.index(END, b)
    except ValueError:
        return lines, None, []
    return lines[:b], lines[b:e + 1], lines[e + 1:]


def new_crontab(text, block):
    before, old, after = split_block(text)
    keep = lambda ls: [l for l in ls if not l.rstrip().endswith(OLD_SYNC_MARK)]
    before, after = keep(before), keep(after)
    if old is None:
        while before and not before[-1].strip():
            before.pop()
        lines = before + ([""] if before else []) + block
    else:
        lines = before + block + after
    return "\n".join(lines) + "\n"


def migrate_systemd(jobs, say):
    if not shutil.which("systemctl"):
        return
    unit_dir = home() / ".config" / "systemd" / "user"
    removed = False
    for j in jobs:
        timer = f'{j["name"]}.timer'
        r = subprocess.run(["systemctl", "--user", "show", "-p", "LoadState,ActiveState,UnitFileState", timer],
                           capture_output=True, text=True)
        props = dict(l.split("=", 1) for l in r.stdout.splitlines() if "=" in l)
        known = r.returncode == 0 and (props.get("LoadState", "not-found") != "not-found"
                                       or props.get("ActiveState") in ("active", "activating")
                                       or props.get("UnitFileState") in ("enabled", "linked"))
        if known:
            d = subprocess.run(["systemctl", "--user", "disable", "--now", timer], capture_output=True, text=True)
            say(f"systemd: disabled {timer}" if d.returncode == 0
                else f"systemd: could not disable {timer}: {d.stderr.strip()}")
        for suffix in ("timer", "service"):
            f = unit_dir / f'{j["name"]}.{suffix}'
            if f.is_symlink():
                f.unlink()
                removed = True
                say(f"systemd: removed link {f}")
    if removed:
        subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)


def cmd_install(args):
    quiet = "--quiet" in args
    say = (lambda s: None) if quiet else print
    jobs, _ = load()
    host = short_hostname()
    old = read_crontab()
    new = new_crontab(old, block_for(jobs, host))
    if new == old:
        say("crontab: unchanged")
    else:
        r = subprocess.run(["crontab", "-"], input=new, text=True, capture_output=True)
        if r.returncode != 0:
            raise ListError(f"crontab - failed: {r.stderr.strip()}")
        if any(l.rstrip().endswith(OLD_SYNC_MARK) for l in old.splitlines()):
            say("crontab: removed the old dotfiles-sync line")
        n = sum(runs_here(j, host) for j in jobs)
        say(f"crontab: wrote the jobs block ({n} job(s) for {host})")
    migrate_systemd(jobs, say)
    return 0


def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def cap_log(path):
    try:
        size = path.stat().st_size
    except FileNotFoundError:
        return
    if size <= LOG_CAP:
        return
    with open(path, "rb") as f:
        f.seek(size - LOG_KEEP)
        tail = f.read()
    nl = tail.find(b"\n")
    tail = tail[nl + 1:] if nl >= 0 else tail
    tmp = path.with_suffix(".log.tmp")
    tmp.write_bytes(tail)
    os.replace(tmp, path)


def cmd_run(args):
    if len(args) != 1:
        print("usage: cron-jobs run NAME", file=sys.stderr)
        return 2
    name = args[0]
    jobs, problems = load(strict=False)
    job = next((j for j in jobs if j["name"] == name), None)
    if job is None:
        print(f"cron-jobs: no job {name!r} in {list_path()}", file=sys.stderr)
        for prob in problems:
            print(f"cron-jobs: {prob}", file=sys.stderr)
        return 2
    sd = state_dir()
    sd.mkdir(parents=True, exist_ok=True)
    log = sd / f"{name}.log"
    lock = open(sd / f"{name}.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        with open(log, "a") as f:
            f.write(f"=== {now_iso()} {name}: still running, skipped\n")
        return 0
    env = dict(os.environ)
    h = str(home())
    env["PATH"] = f"{h}/.claude/bin:{h}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
    started = now_iso()
    t0 = time.monotonic()
    timed_out = False
    with open(log, "ab") as out:
        out.write(f"=== {started} {name}\n".encode())
        for prob in problems:
            out.write(f"note: skipped a bad line in the list: {prob}\n".encode())
        out.flush()
        p = subprocess.Popen(["sh", "-c", job["command"]], stdin=subprocess.DEVNULL, stdout=out,
                             stderr=subprocess.STDOUT, env=env, cwd=h, start_new_session=True)
        try:
            rc = p.wait(timeout=job["timeout"])
        except subprocess.TimeoutExpired:
            timed_out = True
            for sig, grace in ((signal.SIGTERM, 5), (signal.SIGKILL, None)):
                try:
                    os.killpg(p.pid, sig)
                except (ProcessLookupError, PermissionError):
                    break
                try:
                    p.wait(timeout=grace)
                    break
                except subprocess.TimeoutExpired:
                    continue
            # The group outlives its leader while any member runs; reach stragglers.
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass
            p.wait()
            rc = 124
        if rc < 0:
            rc = 128 - rc
        end = "timed out after %ds" % job["timeout"] if timed_out else f"exit {rc}"
        out.write(f"--- {name}: {end} ({time.monotonic() - t0:.0f}s)\n".encode())
    cap_log(log)
    last = {"name": name, "started": started, "ended": now_iso(), "exit": rc, "timed_out": timed_out}
    tmp = sd / f"{name}.last.tmp"
    tmp.write_text(json.dumps(last) + "\n")
    os.replace(tmp, sd / f"{name}.last")
    return rc


def cmd_status(args):
    jobs, problems = load(strict=False)
    host = short_hostname()
    try:
        _, block, _ = split_block(read_crontab())
    except ListError as e:
        print(f"cron-jobs: {e}", file=sys.stderr)
        block = None
    want = block_for(jobs, host)
    in_block = set(block or [])
    rows, failing = [], False
    for j in jobs:
        try:
            last = json.loads((state_dir() / f'{j["name"]}.last').read_text())
            ran, code = last["started"], ("timeout" if last.get("timed_out") else str(last["exit"]))
        except (OSError, ValueError, KeyError):
            last, ran, code = None, "never", "-"
        if not runs_here(j, host):
            cron = "skipped (host)"
        else:
            line = f'{j["schedule"]} "$HOME/.local/bin/cron-jobs" run {j["name"]}'
            cron = "yes" if line in in_block else "no"
            if last and last.get("exit") != 0:
                failing = True
        rows.append((j["name"], j["schedule"], ran, code, cron))
    head = ("JOB", "SCHEDULE", "LAST RUN", "EXIT", "IN CRONTAB")
    widths = [max(len(r[i]) for r in rows + [head]) for i in range(len(head))]
    for r in [head] + rows:
        print("  ".join(c.ljust(w) for c, w in zip(r, widths)).rstrip())
    if block is None:
        print("crontab block: missing; run ~/.local/bin/cron-jobs install")
    elif block != want:
        print("crontab block: stale; run ~/.local/bin/cron-jobs install")
    else:
        print("crontab block: current")
    for prob in problems:
        print(f"bad list line, skipped: {prob}")
    return 1 if failing or problems or block != want else 0


def main(argv):
    cmds = {"install": cmd_install, "run": cmd_run, "status": cmd_status}
    if not argv or argv[0] not in cmds:
        print(__doc__.strip().split("\n\n")[1] if __doc__ else "usage: cron-jobs install|run|status", file=sys.stderr)
        return 2
    try:
        return cmds[argv[0]](argv[1:])
    except ListError as e:
        print(f"cron-jobs: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
