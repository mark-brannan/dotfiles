#!/bin/sh
# signalk-webapp — start/stop the mock webapp rig (scripts/mock-webapp.mjs)
# from a Signal K plugin repo.
#
# Truth is whatever's actually listening on the port, not a pidfile — a
# pidfile alone breaks the moment it's stale, missing, or the rig was
# started some other way (plain `npm run dev:webapp`, a different shell, a
# reboot), and then the script can't even recover the thing it's supposed
# to own. So every action re-derives state from the OS: who's listening on
# this port (lsof), is that actually a mock-webapp.mjs process (its command
# line), not "does a file we wrote still exist." Never pkill/killall by
# pattern across all processes — only ever a single pid, on a single port,
# confirmed by command line first.
#
# Usage:
#   signalk-webapp [port]          start (default 8731); refuses cleanly
#                                   if the port is held by something that
#                                   isn't a mock-webapp.mjs process
#   signalk-webapp --stop [port]   stop whatever mock-webapp.mjs is
#                                   listening on that port (default 8731),
#                                   however it was started
#   signalk-webapp --list          scan for every mock-webapp.mjs process
#                                   actually running, with its port
#
# Env overrides:
#   SIGNALK_REVIEW_REPO   path to the plugin's clone (used only to start;
#                         --stop/--list work on any mock-webapp.mjs found,
#                         regardless of which repo it came from)
#   SIGNALK_REVIEW_ROOT   where logs live (default: ~/.signalk-review)

set -eu

REPO="${SIGNALK_REVIEW_REPO:-$HOME/signalk-noaa-space-weather}"
ROOT="${SIGNALK_REVIEW_ROOT:-$HOME/.signalk-review}"
DEFAULT_PORT=8731
SIGNATURE="mock-webapp.mjs"

die() { echo "signalk-webapp: $*" >&2; exit 1; }

command -v lsof >/dev/null 2>&1 || die "lsof not found — needed to see what's on a port"
command -v ps >/dev/null 2>&1 || die "ps not found"

# pid listening on $1 (TCP, LISTEN), or empty. First match if more than one.
pid_on_port() {
  lsof -tiTCP:"$1" -sTCP:LISTEN 2>/dev/null | head -1
}

# full command line for pid $1, or empty if it's gone.
cmdline_of() {
  ps -o args= -p "$1" 2>/dev/null
}

# True only for an actual node process running the script — not a shell
# that merely has the string somewhere in its argv (this environment's own
# command wrappers do, since they echo the command they're about to run).
# ps's "comm" is the real binary name, unaffected by argv content.
is_ours() {
  pid="$1"
  comm=$(ps -o comm= -p "$pid" 2>/dev/null) || return 1
  [ "$comm" = "node" ] || return 1
  case "$(cmdline_of "$pid")" in
    *"$SIGNATURE"*) return 0 ;;
    *) return 1 ;;
  esac
}

# every currently-running mock-webapp.mjs pid, one per line.
our_pids() {
  ps -eo pid=,comm=,args= 2>/dev/null \
    | awk -v sig="$SIGNATURE" '$2 == "node" && index($0, sig) {print $1}'
}

# TCP port pid $1 is listening on, or empty.
listen_port_of() {
  lsof -aiTCP -sTCP:LISTEN -p "$1" -Fn 2>/dev/null | sed -n 's/^n.*:\([0-9]*\)$/\1/p' | head -1
}

list_rigs() {
  pids=$(our_pids || true)
  if [ -z "$pids" ]; then
    echo "no mock-webapp.mjs processes running"
    return
  fi
  for pid in $pids; do
    port=$(listen_port_of "$pid")
    if [ -n "$port" ]; then
      echo "port $port  running (pid $pid)  http://127.0.0.1:$port/"
    else
      echo "pid $pid  running, not yet listening on any port"
    fi
  done
}

stop_rig() {
  port="$1"
  pid=$(pid_on_port "$port")
  if [ -z "$pid" ]; then
    echo "port $port: nothing listening, nothing to stop"
    return
  fi
  if ! is_ours "$pid"; then
    die "port $port is held by pid $pid, which isn't a $SIGNATURE process — not touching it. cmdline: $(cmdline_of "$pid")"
  fi
  kill "$pid"
  echo "stopped mock webapp on port $port (pid $pid)"
}

start_rig() {
  port="$1"
  mkdir -p "$ROOT"
  [ -d "$REPO/.git" ] || die "no repo at $REPO (set SIGNALK_REVIEW_REPO)"
  [ -f "$REPO/scripts/mock-webapp.mjs" ] || die "$REPO/scripts/mock-webapp.mjs not found"

  existing=$(pid_on_port "$port")
  if [ -n "$existing" ]; then
    if is_ours "$existing"; then
      echo "already running on port $port (pid $existing) — http://127.0.0.1:$port/"
      return
    fi
    die "port $port is already in use by pid $existing, which isn't a $SIGNATURE process. cmdline: $(cmdline_of "$existing"). Pick another port: signalk-webapp <other-port>"
  fi

  logfile="$ROOT/webapp-$port.log"
  ( cd "$REPO" && \
    setsid nohup node scripts/mock-webapp.mjs "$port" \
      > "$logfile" 2>&1 < /dev/null & )
  sleep 1

  pid=$(pid_on_port "$port")
  if [ -z "$pid" ] || ! is_ours "$pid"; then
    die "failed to start — see $logfile"
  fi

  addr=$(hostname -I 2>/dev/null | awk '{print $1}')
  echo "mock webapp rig on port $port (pid $pid):"
  echo "  http://127.0.0.1:$port/"
  [ -n "$addr" ] && echo "  http://$addr:$port/"
  echo "  log: $logfile"
  echo "  stop with: signalk-webapp --stop $port"
}

case "${1:-}" in
  --list) list_rigs ;;
  --stop) shift; stop_rig "${1:-$DEFAULT_PORT}" ;;
  -h|--help) sed -n '2,26p' "$0"; exit 0 ;;
  *[!0-9]*) die "expected a port number, got '$1'" ;;
  *) start_rig "${1:-$DEFAULT_PORT}" ;;
esac
