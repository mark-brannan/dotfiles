#!/bin/sh
# yadm bootstrap: runs automatically after `yadm clone`, or manually via `yadm bootstrap`.
# Idempotent — safe to re-run.
#
# Secrets convention: ciphertext lives tracked at $HOME/secrets/<name>.sops.env
# (encrypted with sops+age, safe to commit). This script decrypts each into
# $HOME/.config/secrets/<name>.env — a path that is NOT tracked and IS gitignored
# (see .gitignore), so plaintext never sits inside the git working tree and can't
# get swept up by a later `yadm add`. .zshrc/.bashrc source everything under
# ~/.config/secrets/*.env at shell startup, EXCEPT claude-token.env, which is
# scoped to a `claude` wrapper function instead so the token isn't exported
# into every shell and everything it spawns.
#
# $HOME/secrets/on-demand/ holds secrets no shell should carry: this script
# never decrypts them, and the script that uses one runs `sops -d` itself.
set -eu

need() { command -v "$1" >/dev/null 2>&1; }
failed=0
# First line of every file written here, so a later run can tell its own
# output from a file someone put in ~/.config/secrets/ by hand.
MARK='# written by yadm bootstrap from'

echo "==> checking tooling"

if ! need yadm; then
  echo "yadm missing — install it first (apt install yadm / brew install yadm), then re-run this script." >&2
  exit 1
fi

if ! need age || ! need sops; then
  echo "age/sops missing."
  if need apt-get; then
    echo "    try: sudo apt-get install -y age; and install sops from https://github.com/getsops/sops/releases"
  elif need brew; then
    echo "    try: brew install age sops"
  else
    echo "    install age (https://github.com/FiloSottile/age) and sops (https://github.com/getsops/sops) manually."
  fi
  echo "    skipping secret decryption until both are present."
else
  echo "==> age/sops present"

  if [ ! -f "$HOME/.config/sops/age/keys.txt" ]; then
    echo "no age key at ~/.config/sops/age/keys.txt on this machine yet."
    echo "    this key is never stored in git — restore it from your password manager,"
    echo "    or generate a new one with: age-keygen -o ~/.config/sops/age/keys.txt"
    echo "    (a new key can't decrypt files encrypted for the old one — you'd need to"
    echo "    re-encrypt with the new recipient from another machine that still has it)."
  else
    echo "==> age key present, decrypting sops-managed secrets"
    export SOPS_AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"
    umask 077
    mkdir -p "$HOME/.config/secrets"
    chmod 700 "$HOME/.config/secrets"
    # A for loop, not find | while: a pipe's subshell would lose `failed`.
    for f in "$HOME"/secrets/*.sops.env; do
      [ -f "$f" ] || continue
      base=$(basename "$f" .sops.env)
      out="$HOME/.config/secrets/$base.env"
      if { echo "$MARK secrets/$base.sops.env"; sops -d "$f"; } > "$out.tmp"; then
        mv "$out.tmp" "$out"
        echo "    decrypted $f -> $out"
      else
        rm -f "$out.tmp"
        echo "    FAILED to decrypt $f (run: sops -d $f)" >&2
        failed=1
      fi
    done
    # A deleted secret, or one moved to on-demand/, must stop reaching
    # shells. Remove what this script wrote; name anything else.
    for out in "$HOME"/.config/secrets/*.env; do
      [ -f "$out" ] || continue
      base=$(basename "$out" .env)
      [ -f "$HOME/secrets/$base.sops.env" ] && continue
      if [ -f "$HOME/secrets/on-demand/$base.sops.env" ] || head -n 1 "$out" | grep -qF "$MARK"; then
        rm -f "$out"
        echo "    removed $out (no secrets/$base.sops.env)"
      else
        echo "    $out has no secrets/$base.sops.env and wasn't written here; shells still source it" >&2
      fi
    done
  fi
fi

# This repo's CLAUDE.md stays out of $HOME, where it would load as an
# ancestor of every repo; the hook gives branch worktrees the whole tree.
# Hook first, so no worktree is made sparse in between. Undo:
# `yadm sparse-checkout disable`, then delete the hook link.
hook_src="$HOME/.local/bin/yadm-post-checkout.sh"
hook="$(yadm rev-parse --path-format=absolute --git-path hooks)/post-checkout" || hook=
if [ -z "$hook" ] || [ ! -x "$hook_src" ]; then
  echo "    no hooks dir or no $hook_src; ~/CLAUDE.md stays" >&2
elif { [ -e "$hook" ] || [ -L "$hook" ]; } && [ "$(readlink "$hook")" != "$hook_src" ]; then
  echo "    $hook is not $hook_src; left alone, so ~/CLAUDE.md stays" >&2
elif ln -sf "$hook_src" "$hook" && yadm sparse-checkout set --no-cone '/*' '!/CLAUDE.md'; then
  echo "==> CLAUDE.md kept out of \$HOME; worktree hook linked"
else
  echo "    keeping CLAUDE.md out of \$HOME failed; ~/CLAUDE.md stays" >&2
fi

# Unattended ff-only sync, every five minutes. Idempotent; see README.
[ -x "$HOME/.local/bin/dotfiles-sync.sh" ] && "$HOME/.local/bin/dotfiles-sync.sh" --install

if [ "$failed" -ne 0 ]; then
  echo "==> bootstrap FAILED: a secret above did not decrypt" >&2
  exit 1
fi
echo "==> bootstrap done"
