[Unit]
Description=Joplin <-> git bridge: sync listed workspaces, commit what changed
# Conflicts are never auto-resolved; the script only reports them.

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/joplin-git-bridge
TimeoutStartSec=120
Nice=10
