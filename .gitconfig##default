[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[user]
	email = markbrannan@gmail.com
	name = Solace (Mark) Brannan
	signingkey = ~/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[rebase]
	autoStash = true
[branch]
	# A branch tracks its own remote branch, never the one it was cut from, so mergify's stack pre-push hook doesn't mistake a PR branch for a stack.
	autoSetupMerge = simple
[push]
	# autoSetupRemote makes a bare `git push` create and track origin/<branch>.
	autoSetupRemote = true
